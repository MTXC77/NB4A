port: 7890
socks-port: 7891
allow-lan: true
mode: rule
log-level: info
external-controller: 127.0.0.1:9090
proxy-providers:
  Provider_B4B017:
    type: http
    url: https://raw.githubusercontent.com/MTXC77/NB4A/refs/heads/main/3月31备用配置①
    interval: 3600
    proxy: DIRECT
    path: ./providers/Provider_B4B017.yaml
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 300
proxy-groups:
  - name: 🚀 手动选择
    type: select
    use:
      - Provider_B4B017
    filter: .*
    proxies:
      - ♻️ 自动选择
